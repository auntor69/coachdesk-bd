{
  "name": "coachdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:types": "node --env-file=.env.local scripts/gen-types.mjs",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "test:schema": "node scripts/check-migrations.mjs",
    "test:scoping": "node scripts/check-scoping.mjs",
    "test:exports": "node scripts/check-server-exports.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:rls:live": "node --env-file=.env.local scripts/test-rls-live.mjs",
    "test:embeds": "node --env-file=.env.local scripts/check-embeds.mjs",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "test": "npm run test:schema && npm run test:scoping && npm run test:exports && npm run test:rls && npm run test:unit",
    "test:live": "npm run test:rls:live && npm run test:embeds"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "pgsql-parser": "^13.19.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
